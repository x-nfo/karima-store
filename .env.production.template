# ============================================
# KARIMA STORE - PRODUCTION ENVIRONMENT
# ============================================
# This file contains configuration for production deployment
# 
# SECURITY WARNING:
# - DO NOT commit this file to version control
# - Store this file securely on production server only
# - Use chmod 600 to restrict file permissions
# - Consider using secret management tools (Vault, AWS Secrets Manager, etc.)
#
# Setup Instructions: See docs/deployment/PRODUCTION_ENV_SETUP.md
# Generate Secrets: Run ./scripts/generate-env-secrets.sh

# ============================================
# SERVER CONFIGURATION
# ============================================
APP_PORT=8080
APP_ENV=production
GO_ENV=production
GO_VERSION=1.24
API_VERSION=v1

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
# REQUIRED: Update all values below
# Example: DB_HOST=192.168.1.100 or db.yourdomain.com
DB_HOST=your_production_db_host
DB_PORT=5432
DB_USER=karima_prod_user
DB_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD_32_CHARS
DB_NAME=karima_db_prod
DB_SSL_MODE=require

# Database Connection Pool (Optional - tune for your workload)
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=5m

# ============================================
# REDIS CONFIGURATION (Caching)
# ============================================
# REQUIRED: Update all values below
# Example: REDIS_HOST=192.168.1.100 or redis.yourdomain.com
REDIS_HOST=your_production_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD_32_CHARS

# Redis Connection Pool (Optional)
# REDIS_MAX_RETRIES=3
# REDIS_POOL_SIZE=10

# ============================================
# AUTHENTICATION CONFIGURATION (Ory Kratos)
# ============================================
# REQUIRED: Update with your production domain
# Example: https://auth.ks-backend.cloud
KRATOS_PUBLIC_URL=https://auth.yourdomain.com
KRATOS_ADMIN_URL=https://auth.yourdomain.com/admin
KRATOS_UI_URL=https://auth.yourdomain.com/ui

# Kratos Session Configuration (Optional)
# KRATOS_SESSION_COOKIE_NAME=karima_session
# KRATOS_SESSION_COOKIE_DOMAIN=.yourdomain.com

# ============================================
# JWT CONFIGURATION (OPTIONAL)
# ============================================
# NOTE: This application uses Ory Kratos for authentication, so JWT is NOT required.
# JWT_SECRET is kept in config for backward compatibility or future use.
# You can safely leave this empty or set a value if you plan to use JWT in the future.
#
# If you want to set it anyway:
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=24h

# JWT Advanced Configuration (Optional)
# JWT_ISSUER=karima-store
# JWT_AUDIENCE=karima-api


# ============================================
# PAYMENT GATEWAY CONFIGURATION (Midtrans)
# ============================================
# REQUIRED: Get from Midtrans Production Dashboard
# URL: https://dashboard.midtrans.com
# Navigate to: Settings → Access Keys (Production Mode)
MIDTRANS_SERVER_KEY=YOUR_PRODUCTION_MIDTRANS_SERVER_KEY
MIDTRANS_CLIENT_KEY=YOUR_PRODUCTION_MIDTRANS_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_API_BASE_URL=https://app.midtrans.com/snap/v1

# Midtrans Configuration (Optional)
# MIDTRANS_NOTIFICATION_URL=https://api.yourdomain.com/v1/webhooks/midtrans
# MIDTRANS_FINISH_URL=https://yourdomain.com/payment/success
# MIDTRANS_ERROR_URL=https://yourdomain.com/payment/error

# ============================================
# SHIPPING CONFIGURATION (RajaOngkir/Komerce)
# ============================================
# REQUIRED: Get from RajaOngkir Pro/Business Account
# URL: https://rajaongkir.com
# Note: Sandbox keys won't work in production!
RAJAONGKIR_API_KEY=YOUR_PRODUCTION_RAJAONGKIR_API_KEY
RAJAONKIR_API_KEY_SHIPPING_DELIVERY=YOUR_PRODUCTION_RAJAONGKIR_SHIPPING_KEY
RAJAONGKIR_BASE_URL=https://pro.rajaongkir.com/api

# Shipping Configuration (Optional)
# RAJAONGKIR_TIMEOUT=30s
# RAJAONGKIR_CACHE_TTL=1h

# ============================================
# STORAGE CONFIGURATION (Cloudflare R2)
# ============================================
# REQUIRED: Setup Cloudflare R2 bucket and get credentials
# URL: https://dash.cloudflare.com → R2
FILE_STORAGE=r2
FILE_UPLOAD_MAX_SIZE=10MB

# Get from Cloudflare Dashboard
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=karima-media-prod
R2_PUBLIC_URL=https://media.yourdomain.com
R2_REGION=auto

# Storage Configuration (Optional)
# R2_MAX_FILE_SIZE=10485760
# R2_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
# REQUIRED: Configure production email service
# 
# Option 1: Gmail (with App Password)
# - Enable 2FA on Google Account
# - Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASSWORD=your_gmail_app_specific_password

# Option 2: SendGrid (Recommended for production)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASSWORD=your_sendgrid_api_key

# Option 3: AWS SES
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USER=your_aws_smtp_username
# EMAIL_PASSWORD=your_aws_smtp_password

# Email Configuration (Optional)
# EMAIL_FROM_NAME=Karima Store
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_REPLY_TO=support@yourdomain.com

# ============================================
# NOTIFICATION CONFIGURATION (Fonnte - WhatsApp)
# ============================================
# REQUIRED: Get from Fonnte Dashboard
# URL: https://fonnte.com
FONNTE_TOKEN=YOUR_PRODUCTION_FONNTE_TOKEN
FONNTE_URL=https://api.fonnte.com/send

# WhatsApp Configuration (Optional)
# FONNTE_TIMEOUT=30s
# FONNTE_RETRY_COUNT=3

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Production: Use 'warn' or 'error' level
# Options: debug, info, warn, error
LOG_LEVEL=warn
LOG_FILE=logs/app.log

# Logging Configuration (Optional)
# LOG_FORMAT=json
# LOG_MAX_SIZE=100
# LOG_MAX_BACKUPS=10
# LOG_MAX_AGE=30

# ============================================
# CACHE CONFIGURATION
# ============================================
CACHE_TYPE=redis
CACHE_DURATION=1h

# Cache Configuration (Optional)
# CACHE_DEFAULT_TTL=3600
# CACHE_MAX_ENTRIES=10000

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================
# Adjust based on expected traffic
# Current: 100 requests per minute per IP
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_LIMIT=100

# Advanced Rate Limiting (Optional)
# RATE_LIMIT_AUTH_LIMIT=1000
# RATE_LIMIT_PUBLIC_LIMIT=100
# RATE_LIMIT_BURST=20

# ============================================
# CORS CONFIGURATION
# ============================================
# CRITICAL: Only allow your production domains
# Separate multiple domains with comma
# Example: https://ks-backend.cloud,https://www.ks-backend.cloud
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# CORS Configuration (Optional)
# CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
# CORS_HEADERS=Content-Type,Authorization
# CORS_CREDENTIALS=true
# CORS_MAX_AGE=86400

# ============================================
# DATABASE MIGRATIONS
# ============================================
MIGRATION_SOURCE=migrations

# Migration Configuration (Optional)
# MIGRATION_TABLE=schema_migrations
# MIGRATION_AUTO=false

# ============================================
# SECURITY CONFIGURATION (Optional but Recommended)
# ============================================
# API Key for internal service-to-service communication
# API_KEY=REPLACE_WITH_GENERATED_API_KEY

# Session Configuration
# SESSION_SECRET=REPLACE_WITH_GENERATED_SESSION_SECRET
# SESSION_MAX_AGE=86400

# Encryption Key for sensitive data
# ENCRYPTION_KEY=REPLACE_WITH_GENERATED_ENCRYPTION_KEY

# CSRF Protection
# CSRF_SECRET=REPLACE_WITH_GENERATED_CSRF_SECRET
# CSRF_COOKIE_NAME=karima_csrf

# ============================================
# MONITORING & OBSERVABILITY (Optional)
# ============================================
# Sentry for error tracking
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=v1.0.0

# Prometheus metrics
# METRICS_ENABLED=true
# METRICS_PORT=9090
# METRICS_PATH=/metrics

# Health check
# HEALTH_CHECK_PATH=/health
# HEALTH_CHECK_TIMEOUT=5s

# ============================================
# PERFORMANCE TUNING (Optional)
# ============================================
# Go Runtime
# GOMAXPROCS=4
# GOGC=100

# HTTP Server
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=120s
# HTTP_MAX_HEADER_BYTES=1048576

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# Enable/disable features in production
# FEATURE_PAYMENT_ENABLED=true
# FEATURE_SHIPPING_ENABLED=true
# FEATURE_NOTIFICATIONS_ENABLED=true
# FEATURE_ANALYTICS_ENABLED=true

# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================
# Before deploying to production, ensure:
#
# SECURITY:
# [ ] All placeholder values replaced with actual credentials
# [ ] Strong, unique passwords used (minimum 32 characters)
# [ ] JWT secret is strong random hex (minimum 64 characters)
# [ ] File permissions set to 600: chmod 600 .env.production
# [ ] Secrets stored in password manager or secret vault
# [ ] SSL/TLS enabled for all external connections
# [ ] Database SSL mode set to 'require' or 'verify-full'
#
# SERVICES:
# [ ] Database connection tested and working
# [ ] Redis connection tested and working
# [ ] Ory Kratos configured and accessible
# [ ] Midtrans production keys verified
# [ ] RajaOngkir production API working
# [ ] Cloudflare R2 bucket created and accessible
# [ ] Email SMTP tested (send test email)
# [ ] WhatsApp Fonnte verified
#
# CONFIGURATION:
# [ ] CORS origins set to production domains only
# [ ] Log level set to 'warn' or 'error'
# [ ] Rate limiting configured for expected traffic
# [ ] File storage set to 'r2' (not 'local')
# [ ] Midtrans production mode enabled
# [ ] RajaOngkir using production endpoints
#
# INFRASTRUCTURE:
# [ ] Database backups configured
# [ ] Redis persistence enabled
# [ ] Monitoring and alerting set up
# [ ] Log aggregation configured
# [ ] SSL certificates installed and valid
# [ ] Firewall rules configured
# [ ] Load balancer configured (if applicable)
#
# TESTING:
# [ ] Health check endpoint responding
# [ ] Database migrations run successfully
# [ ] All API endpoints tested
# [ ] Payment flow tested end-to-end
# [ ] Email delivery tested
# [ ] WhatsApp notifications tested
# [ ] File upload/download tested
#
# DOCUMENTATION:
# [ ] Deployment runbook updated
# [ ] Incident response plan documented
# [ ] Rollback procedure documented
# [ ] Team access documented
# [ ] Secret rotation schedule set
#
# ============================================
# QUICK START COMMANDS
# ============================================
#
# 1. Generate secrets:
#    ./scripts/generate-env-secrets.sh
#
# 2. Copy to production server:
#    scp .env.production user@server:/app/.env.production
#
# 3. Set secure permissions:
#    ssh user@server "chmod 600 /app/.env.production"
#
# 4. Verify configuration:
#    ssh user@server "cd /app && make verify-env"
#
# 5. Run migrations:
#    ssh user@server "cd /app && make migrate-up"
#
# 6. Start application:
#    ssh user@server "cd /app && make start-prod"
#
